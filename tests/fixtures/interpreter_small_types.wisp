(fn byte-at ((n s32)) u8 (list-get (list-push (list-new u8) n) 0))
(record packet (code u8))
(variant outcome (empty) (data u8))
(fn identity ((x T)) T (where T) x)
(export (fn byte-add () s32 (i32.add (byte-at 255) 1)))
(export (fn byte-wide () s32 (i32.wrap_i64 (i64.extend_i32_u (byte-at 200)))))
(export (fn byte-record () s32 (i32.add (packet.code (packet (byte-at 42))) 0)))
(export (fn byte-variant () s32 (match (data (byte-at 42)) ((empty) 0) ((data b) (i32.add b 0)))))
(export (fn byte-generic () s32 (i32.add (identity (byte-at 42)) 0)))
(export (fn byte-value () u8 (byte-at 255)))
