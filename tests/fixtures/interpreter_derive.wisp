(trait (Eq T) (fn = ((a T) (b T)) s32))
(record point (x s32) (y s32))
(record scalars (n s64) (f f32) (d f64) (b u8))
(derive Eq point)
(derive Eq scalars)
(fn byte () u8 (list-get (list-push (list-new u8) 255) 0))
(fn same ((a T) (b T)) s32 (where (Eq T)) (= a b))
(fn mk-point ((x s32) (y s32)) point (point x y))
(fn mk-scalars ((n s64) (f f32) (d f64) (b u8)) scalars (scalars n f d b))
(export (fn equal () s32 (same (mk-point 1 2) (mk-point 1 2))))
(export (fn first-diff () s32 (= (mk-point 9 2) (mk-point 1 2))))
(export (fn last-diff () s32 (= (mk-point 1 9) (mk-point 1 2))))
(export (fn mixed-equal () s32 (= (mk-scalars 4294967296s64 1f32 2.0 (byte)) (mk-scalars 4294967296s64 1f32 2.0 (byte)))))
(export (fn wide-diff () s32 (= (mk-scalars 4294967296s64 1f32 2.0 (byte)) (mk-scalars 0s64 1f32 2.0 (byte)))))
(export (fn nan-diff () s32 (= (mk-scalars 0s64 (f32.div 0f32 0f32) 2.0 (byte)) (mk-scalars 0s64 (f32.div 0f32 0f32) 2.0 (byte)))))
(export (fn zero-equal () s32 (= (mk-scalars 0s64 -0.0f32 -0.0 (byte)) (mk-scalars 0s64 0f32 0.0 (byte)))))
