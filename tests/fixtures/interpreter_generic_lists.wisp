(include "../../std/list.wisp")
(fn numbers () (list s32)
  (list-push (list-push (list-push (list-new s32) 1) 2) 3))
(fn double ((x T)) T (where (Add T)) (+ x x))
(fn positive ((x s32)) s32 (> x 1))
(export (fn mapped () s32 (sum (map double (numbers)))))
(export (fn filtered () s32 (sum (filter positive (numbers)))))
(export (fn reversed () s32 (list-get (reverse (numbers)) 0)))
(export (fn found () s32 (contains (numbers) 2)))
(export (fn absent () s32 (contains (numbers) 9)))
(export (fn folded () s32 (fold + (zero) (numbers))))
(export (fn count () s32 (length (numbers))))
